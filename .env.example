# Copy this file to .env and fill in real values. Never commit .env.

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/benchmark_quote_db

# Backend Security & Environment
SECRET_KEY=replace-with-a-long-random-string
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend URL (used to generate invitation and password-reset links)
FRONTEND_URL=http://localhost:5173

# Email Service Configuration
# Set to 'console' for local testing (logs email content and link to terminal)
# Set to 'gmail' for actual email delivery via Google Workspace / Gmail SMTP
EMAIL_PROVIDER=console

# SMTP / Gmail Settings (required only when EMAIL_PROVIDER=gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=presales@benchmarkbroadcast.com
SMTP_PASSWORD=your-16-char-google-app-password
SMTP_FROM_EMAIL=presales@benchmarkbroadcast.com
SMTP_FROM_NAME=Benchmark Broadcast Systems

# AI/LLM service for free-text requirement capture (optional)
AI_PROVIDER=
AI_API_KEY=
